{
  "summary": {
    "icon": "/assets/home_mindtrails.png",
    "title": "TestProtocol",
    "description": "This is a test protocol"
  },
  "home": {
    "element": {
      "type": "list",
      "elements": [
        {
          "type": "goals"
        },
        {
          "type": "sessions",
          "left": {
            "text": "{       0     }SessionsCompleted",
            "icon": {
              "url": "/assets/completed.png",
              "tint": false
            }
          },
          "right": {
            "text": "LaunchSession",
            "icon": {
              "url": "/assets/unlocked.png",
              "tint": false
            },
            "action": "flow: //flows/doses"
          }
        },
        {
          "type": "button",
          "action": {
            "text": "ShowSurveyModal",
            "action": "navmodal: //Survey"
          }
        },
        {
          "type": "carousel",
          "actions": [
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow: //flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey1",
              "icon": "/assets/home_instructions.png",
              "action": "flow: //flows/how%20was%20your%20day%3f",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey2",
              "icon": "/assets/home_resources.png",
              "action": "flow: //flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            },
            {
              "text": "survey3",
              "icon": "/assets/home_anxiety.png",
              "action": "flow: //flows/survey3",
              "backgroundcolor": "#1A5C2FDA",
              "markcompleted": true
            }
          ]
        },
        {
          "type": "tiles",
          "actions": [
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow: //flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey1",
              "icon": "/assets/home_instructions.png",
              "action": "flow: //flows/how%20was%20your%20day%3F",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey2",
              "icon": "/assets/home_resources.png",
              "action": "flow: //flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            },
            {
              "text": "survey3",
              "icon": "/assets/home_anxiety.png",
              "action": "flow: //flows/survey3",
              "backgroundcolor": "#1A5C2FDA",
              "markcompleted": true
            }
          ]
        }
      ]
    }
  },
  "menu": [
    {
      "text": "Home",
      "icon": "/assets/menu_home.png"
    }
  ],
  "settings": {
    "configs": "flow: //flows/configs.json"
  },
  "triggers": [
    {
      "id": "trigger_1",
      "type": "Reminder",
      "threshold": "2.00: 00: 00",
      "action": {
        "type": "list",
        "listtype": "sequential",
        "actions": [
          {
            "type": "notification",
            "path": "flow: //flows/random1",
            "title": "ReminderAlert!",
            "message": "Wenoticedyouhaven’tcompletedyourrandom1"
          },
          {
            "type": "notification",
            "path": "flow: //flows/survey2",
            "title": "ReminderAlert!",
            "message": "Wenoticedyouhaven’tcompletedyoursurvey2"
          }
        ]
      }
    },
    {
      "type": "timing",
      "id": "trigger_2",
      "frequency": "00: 05: 00",
      "action": {
        "type": "notification",
        "survey": true,
        "path": "flow: //flows/survey1",
        "title": "SurveyAlert!",
        "message": "It's time for your survey1 survey"
      }
    },
    {
      "id": "trigger_3",
      "type": "timing",
      "frequency": "1",
      "time": "08:00",
      "action": {
        "type": "notification",
        "survey": true,
        "path": "flow://flows/survey2",
        "expiry": "11:00",
        "title": "Survey Alert!",
        "message": "It'stimeforyoursurvey2survey"
      }
    },
    {
      "id": "trigger_4",
      "type": "random",
      "days": 7,
      "choose": 3,
      "time": "${       random_time,       15: 00     }",
      "action": {
        "type": "list",
        "listtype": "random",
        "actions": [
          {
            "type": "notification",
            "survey": true,
            "path": "flow: //flows/random1",
            "expiry": "18: 00",
            "title": "SurveyAlert!",
            "message": "It's time for your random1 survey"
          },
          {
            "type": "notification",
            "survey": true,
            "path": "flow://flows/random2",
            "expiry": "18:00",
            "title": "Survey Alert!",
            "message": "It'stimeforyourrandom2survey"
          },
          {
            "type": "notification",
            "survey": true,
            "path": "flow: //flows/random3",
            "expiry": "18: 00",
            "title": "SurveyAlert!",
            "message": "It's time for your random3 survey"
          }
        ]
      }
    }
  ],
  "probes": [
    {
      "type": "Location",
      "optional": true,
      "interval": "00:00:01",
      "accuracy": 5
    }
  ],
  "devices": [
    {
      "type": "Fitbit",
      "channel": "Api",
      "path": "https://api.fitbit.com/1/user/-",
      "endpoints": [
        {
          "path": "activities/steps",
          "days": 10,
          "writesdatum": true,
          "goals": [
            {
              "type": "percentile",
              "show-loading": true,
              "field": "steps",
              "days": 10,
              "percentile": 0.6
            }
          ],
          "triggers": [
            {
              "id": "trigger_6",
              "type": "device",
              "timewindowdays": 1,
              "aggregation": "sum",
              "condition": [
                "steps",
                "<",
                "2000"
              ],
              "action": {
                "type": "notification",
                "title": "Tracker Alert!",
                "message": "Hi! Your step count is low, make sure you to walk and stay active."
              }
            }
          ]
        }
      ]
    },
    {
      "type": "WisePill",
      "channel": "Webhook",
      "goals": [
        {
          "type": "binarypercentage",
          "field": "event",
          "days": 7,
          "bounds": [
            {
              "lower-bound": 0,
              "upper-bound": 0.6,
              "text": "You'remissingseveraldoses.Pleasetrytotakeyourmedicationmoreconsistently.",
              "summary": "LowAdherence",
              "color": "#ff9187"
            },
            {
              "lower-bound": 0.6,
              "upper-bound": 0.8,
              "text": "You're taking most of your doses. A little more consistency will help.",
              "summary": "Moderate Adherence",
              "color": "#F5E050"
            },
            {
              "lower-bound": 0.8,
              "upper-bound": 1,
              "text": "You'reconsistentlytakingyourmedication.Keepitup!",
              "summary": "HighAdherence",
              "color": "#65bf65"
            }
          ]
        }
      ]
    }
  ]
}
