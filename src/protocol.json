{
  "theme_light": {
    "accent": "#007BFF",
    "text": "#424242",
    "primary": "#FFFFFF",
    "secondary": "#F5F5F5",
    "secondarybutton": "#EEEEEE",
    "destructive": "#FF3B30",
    "success": "#34C759"
  },
  "theme_dark": {
    "accent": "#66B2FF",
    "text": "#FFFFFF",
    "primary": "#121212",
    "secondary": "#202020",
    "secondarybutton": "#333333",
    "destructive": "#FF453A",
    "success": "#30D158"
  },
  "start_flow": "flow://flows/survey1",
  "home": {
    "element": {
      "type": "list",
      "elements": [
        {
          "type": "alert",
          "title": "Test Protocol",
          "message": "assignment_1: ${global:assignment_1}",
          "icon": "/assets/home_instructions.png"
        },
        {
          "type": "devices",
          "summary": [
            {
              "device_id": "device_1",
              "text": "Oura Ring",
              "icon": {
                "url": "/assets/oura.png"
              }
            },
            {
              "device_id": "device_2",
              "text": "WisePill",
              "icon": {
                "url": "/assets/wisepill.png"
              }
            }
          ]
        },
        {
          "type": "sessions",
          "left": {
            "text": "{0} Sessions Completed",
            "icon": {
              "url": "/assets/completed.png",
              "tint": false
            }
          },
          "right": {
            "text": "Launch Session",
            "icon": {
              "url": "/assets/unlocked.png",
              "tint": false
            },
            "action": "flow://flows/doses"
          }
        },
        {
          "type": "survey",
          "action": {
            "text": "Surveys",
            "action": "navmodal://Survey"
          }
        },
        {
          "type": "carousel",
          "title": "Carousel header",
          "actions": [
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey 1",
              "icon": "/assets/home_instructions.png",
              "action": "flow://flows/how%20was%20your%20day%3f",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey 2",
              "icon": "/assets/home_resources.png",
              "action": "flow://flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            },
            {
              "text": "survey 3",
              "icon": "/assets/home_anxiety.png",
              "action": "flow://flows/survey3",
              "backgroundcolor": "#1A5C2FDA",
              "markcompleted": true
            }
          ]
        },
        {
          "type": "sublist",
          "title": "Sub List",
          "icon": "/assets/home_anxiety.png",
          "actions": [
            {
              "text": "survey 1, not a report",
              "action": "flow://flows/survey2"
            },
            {
              "text": "survey 2",
              "action": "flow://flows/survey2",
              "report": true
            },
            {
              "text": "survey 3",
              "action": "flow://flows/survey3"
            }
          ]
        },
        {
          "type": "tiles",
          "title": "Tiles header",
          "actions": [
            {
              "text": "Video Flow",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/video",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": false
            },
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey 1",
              "icon": "/assets/home_instructions.png",
              "action": "flow://flows/how%20was%20your%20day%3F",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey 2",
              "icon": "/assets/home_resources.png",
              "action": "flow://flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            }
          ]
        }
      ]
    }
  },
  "menu": [
    {
      "text": "Home",
      "icon": "/assets/menu_home.png"
    },
    {
      "text": "Long",
      "icon": "/assets/menu_home.png",
      "action": "flow://flows/long"
    }
  ],
  "settings": {
    "configs": "flow://flows/configs.json"
  },
  "surveys": {
    "survey_1": {
      "type": "frequency",
      "frequency": "00:05:00",
      "path": "flow://flows/survey1",
      "expiry": "00:02:00"
    },
    "survey_2": {
      "type": "frequency",
      "frequency": "14",
      "time": "20:00",
      "skip": 1,
      "path": "flow://flows/survey2"
    },
    "survey_3": {
      "type": "random",
      "period": "00:10:00",
      "choose": 3,
      "time": "${global:random_time,15:00}",
      "paths": [
        "flow://flows/random1",
        "flow://flows/random2",
        "flow://flows/random3"
      ]
    },
    "survey_4": {
      "type": "cron",
      "cron": "*/2 * * * *",
      "path": "flow://flows/cron",
      "expiry": "00:01:00"
    }
  },
  "reminders": {
    "reminder_1": {
      "type": "survey",
      "survey_id": "survey_1",
      "frequency": "00:01:00",
      "take": 2
    }
  },
  "probes": [
    {
      "type": "Location",
      "optional": true,
      "interval": "00:00:01",
      "accuracy": 5
    },
    {
      "type": "Accelerometer",
      "optional": true,
      "interval": "00:00:01",
      "speed": "Game"
    },
    {
      "type": "Battery",
      "optional": true,
      "interval": "00:00:01"
    },
    {
      "type": "AmbientLight",
      "optional": true,
      "interval": "00:00:01"
    }
  ],
  "devices": {
    "device_1": {
      "type": "Oura",
      "connect_title": "Login to Oura",
      "connect_description": "This study requires Oura integration. We are about to send you to Oura to authenticate and then you will be redirected back to our app",
      "android_sync": "deeplink://com.ouraring.oura",
      "ios_sync": "deeplink://Oura://",
      "webhook_data_types": [
        "tag",
        "daily_activity",
        "workout",
        "sleep"
      ],
      "scopes": [
        "tag",
        "daily",
        "workout",
        "sleep",
        "ring_configuration"
      ],
      "jobs": [
        "oura_job_1",
        "oura_job_2"
      ]
    },
    "device_2": {
      "type": "WisePill",
      "connect_title": "Enter imei number",
      "connect_description": "Enter imei number of your WisePill box to connect. This will allow us to track when you take your medication and send you reminders if you forget."
    }
  },
  "goals": {
    "goal_1": {
      "device_id": "device_1",
      "data_type": "daily_activity",
      "type": "percentile",
      "field": "steps",
      "required_days": 7,
      "percentile": 0.6
    },
    "goal_2": {
      "device_id": "device_2",
      "data_type": "datums",
      "type": "percentage",
      "field": "events",
      "required_days": 7,
      "target_value": 1
    }
  },
  "jobs": {
    "oura_job_1": {
      "type": "device",
      "service": "Oura",
      "data_type": "daily_activity",
      "days": 1,
      "condition": [
        "non_wear_time",
        "<",
        "36000"
      ],
      "notification_id": "notification_1"
    },
    "oura_job_2": {
      "type": "device",
      "service": "Oura",
      "data_type": "daily_activity",
      "days": 1,
      "condition": [
        "steps",
        "<",
        "2000"
      ],
      "notification_id": "notification_2"
    }
  },
  "notifications": {
    "notification_1": {
      "type": "remote",
      "expiry": "1",
      "title": "Tracker Alert!",
      "message": "Hi! We’ve noticed your tracker hasn’t recorded much data over the past two days. Please try to wear it as much as possible—ideally all day. If it’s not working or you’re having trouble, let us know so we can help",
      "action": "navpage://Devices"
    },
    "notification_2": {
      "type": "remote",
      "expiry": "1",
      "title": "Tracker Alert!",
      "message": "Hi! Your step count is low, make sure you to walk and stay active.",
      "action": "navpage://Devices"
    }
  }
}
